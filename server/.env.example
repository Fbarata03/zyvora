NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://zyvora:zyvora_dev_password@localhost:5432/zyvora?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Limites e timeout dos pedidos à IA (por utilizador)
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=500
AI_TIMEOUT_MS=60000
